{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "valid": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["valid", "reasons", "risk_score"]
}